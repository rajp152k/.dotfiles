# vi info
alias info='info --vi-keys'

#mouseless
alias ml='doas /home/tbm/go/bin/mouseless --config ~/.config/mouseless/config.yaml'

#pi
alias pi0='cd ~/source/scratch/pi && pi'

#polylith
alias cply='clj -M:poly'

#wshowkeys
alias wsk='wshowkeys  -F "Terminess Nerd Font 64"  -f "#00FF00"  -s "#AA00AA"  -a bottom  -m 256'

#keyboard-sounds
alias ksp='kbs-pro'

